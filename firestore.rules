rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmailLower() {
      return (request.auth != null && request.auth.token.email is string)
        ? request.auth.token.email.lower()
        : '';
    }

    function isShopAdmin() {
      return adminEmailLower() == "pubudurox530@gmail.com" ||
             adminEmailLower() == "pubudueshop@gmail.com";
    }
    
    // --- PART REQUESTS RULES ---
    match /requests/{requestId} {
      // Allow any authenticated user (including anonymous) to submit a request
      allow create: if request.auth != null;
      
      // Only authorized admins can read, update or delete requests
      allow read, update, delete: if isShopAdmin();
    }

    // --- ORDERS RULES ---
    match /orders/{orderId} {
      // Allow any authenticated user (including anonymous) to log an order
      allow create: if request.auth != null;
      
      // Only authorized admins can read or manage orders
      allow read, update, delete: if isShopAdmin();
    }
    
    // --- SHOP & PRODUCTS RULES ---
    match /shop/{document=**} {
      // Publicly readable, but only admins can modify
      allow read: if true;
      allow write: if isShopAdmin();
    }
    
    // --- CATEGORIES RULES ---
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isShopAdmin();
    }

    // --- OTHER COLLECTIONS (Default to Admin-Only) ---
    match /{document=**} {
      allow read, write: if isShopAdmin();
    }
  }
}
