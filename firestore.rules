rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isShopAdmin() {
      return request.auth != null && (
        request.auth.uid == "oH6HjEXzEnUiy6K5xaSukAobMsC2" ||
        request.auth.uid == "5SnWGgzV1qUTtiUWxlcBFxIy1MB2" ||
        request.auth.token.email == "pubudurox530@gmail.com"
      );
    }
    
    // --- PART REQUESTS RULES (With payload validation & anti-spam limits) ---
    match /requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'phone', 'partNumber'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 25
        && request.resource.data.partNumber is string && request.resource.data.partNumber.size() > 0 && request.resource.data.partNumber.size() <= 150;
      
      // Only authorized admins can read, update or delete requests
      allow read, update, delete: if isShopAdmin();
    }

    // --- ORDERS RULES (With payload validation & anti-spam limits) ---
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['invoiceId', 'customer', 'items', 'total'])
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50;
      
      // Only authorized admins can read or manage orders
      allow read, update, delete: if isShopAdmin();
    }

    // --- USERS RULES (Users can read/write only their own data) ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // --- SHOP & PRODUCTS RULES ---
    match /shop/{document=**} {
      // Publicly readable, but only admins can modify
      allow read: if true;
      allow write: if isShopAdmin();
    }
    
    // --- CATEGORIES RULES ---
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isShopAdmin();
    }

    // --- OTHER COLLECTIONS (Default to Admin-Only) ---
    match /{document=**} {
      allow read, write: if isShopAdmin();
    }
  }
}
