# Server Port
PORT=5000

# Allowed CORS Origins (Frontend domains that can make requests)
ALLOWED_ORIGINS=https://ichouse.lk,http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500

# Firebase Project Configuration
FIREBASE_PROJECT_ID=pubudu-inventry

# Path to Firebase Service Account JSON (Download from Firebase Console -> Project Settings -> Service Accounts)
# Or provide the JSON string directly in FIREBASE_SERVICE_ACCOUNT_JSON
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Admin API Key for securing inventory modifications from external scripts (Optional)
ADMIN_SECRET_KEY=pubudu_admin_secret_key_change_me
