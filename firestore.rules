rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isShopAdmin() {
      return request.auth != null && (
        request.auth.uid == "oH6HjEXzEnUiy6K5xaSukAobMsC2" ||
        request.auth.uid == "5SnWGgzV1qUTtiUWxlcBFxIy1MB2"
      );
    }
    
    // --- PART REQUESTS RULES ---
    match /requests/{requestId} {
      // Allow any authenticated user (including anonymous) to submit a request
      allow create: if request.auth != null;
      
      // Only authorized admins can read, update or delete requests
      allow read, update, delete: if isShopAdmin();
    }

    // --- ORDERS RULES ---
    match /orders/{orderId} {
      // Allow any authenticated user (including anonymous) to log an order
      allow create: if request.auth != null;
      
      // Only authorized admins can read or manage orders
      allow read, update, delete: if isShopAdmin();
    }

    // --- USERS RULES (Users can read/write only their own data) ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // --- SHOP & PRODUCTS RULES ---
    match /shop/{document=**} {
      // Publicly readable, but only admins can modify
      allow read: if true;
      allow write: if isShopAdmin();
    }
    
    // --- CATEGORIES RULES ---
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isShopAdmin();
    }

    // --- OTHER COLLECTIONS (Default to Admin-Only) ---
    match /{document=**} {
      allow read, write: if isShopAdmin();
    }
  }
}
